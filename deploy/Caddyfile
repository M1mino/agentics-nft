{
    http_port 8080
    https_port 8443
}

agenticsai.online {
    bind 0.0.0.0

    tls internal

    # Agentics Mini App + API
    handle_path /agentics* {
        reverse_proxy localhost:8006
    }

    # Metadata for NFT collection (TEP-62)
    handle_path /metadata/* {
        root * /root/agentics-nft/metadata
        file_server
    }

    # Images
    handle_path /images/* {
        root * /root/agentics-nft/images
        file_server
    }

    # Catch-all: redirect to Mini App
    handle_path / {
        redir https://agenticsai.online/agentics permanent
    }
}
