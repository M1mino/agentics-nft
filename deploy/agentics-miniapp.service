[Unit]
Description=Agentics Mini App Server
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/.openclaw/workspace/nft-ai-agents/miniapp
ExecStart=/usr/local/lib/hermes-agent/venv/bin/uvicorn server:app --host 0.0.0.0 --port 8006
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
